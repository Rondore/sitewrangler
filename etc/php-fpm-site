[user_USERNAMEE]
listen = "/home/USERNAMEE/php-fpm.sock"
listen.owner = "daemon"
listen.group = "daemon"
listen.mode = 0660
user = "USERIDD"
group = "GRUOUPIDD"
pm = ondemand
pm.max_children = 25
pm.process_idle_timeout = 15
slowlog = "/home/USERNAMEE/logs/php.slow.log"
php_admin_value[error_log] = "/home/USERNAMEE/logs/php.error.log"
php_admin_flag[log_errors] = on
php_admin_value[sys_temp_dir] = "/home/USERNAMEE/tmp"
php_admin_value[upload_tmp_dir] = "/home/USERNAMEE/tmp"
php_admin_value[max_input_vars] = 10000
php_value[session.save_handler] = files
php_value[session.save_path] = "/home/USERNAMEE/tmp"
php_value[date.timezone] = "America/Denver"
env[TMPDIR] = "/home/USERNAMEE/tmp"
catch_workers_output = yes

